{
  "name": "betwithfriends",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cf:build": "opennextjs-cloudflare build --config wrangler.jsonc",
    "cf:deploy": "npm run cf:build && wrangler deploy --config wrangler.jsonc",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:deploy:production": "wrangler deploy --config worker/wrangler.production.toml",
    "db:init": "wrangler d1 execute betwithfriends --local --file=worker/src/db/schema.sql --config worker/wrangler.toml",
    "db:create": "wrangler d1 create betwithfriends --config worker/wrangler.toml",
    "db:seed": "wrangler d1 execute betwithfriends --local --file=worker/src/db/reset-and-seed.sql --config worker/wrangler.toml",
    "vapid:generate": "node -e \"const {generateVAPIDKeys}=require('web-push');const k=generateVAPIDKeys();console.log('Public:',k.publicKey);console.log('Private:',k.privateKey);\""
  },
  "dependencies": {
    "jose": "^6.2.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  }
}
