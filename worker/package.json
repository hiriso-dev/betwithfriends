{
  "name": "betwithfriends-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:init": "wrangler d1 execute betwithfriends --local --file=src/db/schema.sql --config wrangler.toml",
    "db:init:remote": "wrangler d1 execute betwithfriends --file=src/db/schema.sql --config wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  }
}
